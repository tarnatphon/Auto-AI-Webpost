# Auto-AI-WebPost - copy to .env and fill in ONLY what you use.
# .env is gitignored. Never commit real secrets.

# ---- LLM (optional; pollinations works with NO key) ----
# OPENAI_API_KEY=sk-...            # for provider: openai (also works with OpenRouter/Groq base urls)
# GEMINI_API_KEY=AIza...           # for provider: gemini (free tier: aistudio.google.com/apikey)

# ---- Origin site (start here) ----
GITHUB_TOKEN=ghp_xxx                  # fine-grained PAT, Contents: read+write
GITHUB_REPO=yourname/yourname.github.io

# ---- Blog platforms ----
DEVTO_API_KEY=                        # dev.to/settings/extensions
WP_SITE=https://yourblog.wordpress.com
WP_USER=you
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx
BLOGGER_ACCESS_TOKEN=ya29.xxx         # via https://developers.google.com/oauthplayground
BLOGGER_BLOG_ID=1234567890
HASHNODE_TOKEN=                       # NOTE: API now needs Hashnode Pro ($5/mo)
HASHNODE_PUBLICATION_ID=

# ---- Tumblr (one app: tumblr.com/oauth/apps, then: python -m autowebpost.cli connect tumblr) ----
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
TUMBLR_BLOG=yourblog.tumblr.com

# ---- Social ----
MASTODON_INSTANCE=https://mastodon.social
MASTODON_TOKEN=
REDDIT_CLIENT_ID=                       # script app: reddit.com/prefs/apps
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=                       # no /r/, e.g. automation
# AUTOWEBPOST_ALLOW_PUBLIC=1           # required before `publish --live` can post to undraftable platforms

# ---- Write.as (optional; anonymous works with no config) ----
WRITEAS_INSTANCE=
WRITEAS_ALIAS=
WRITEAS_PASSWORD=
